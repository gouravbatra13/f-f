# Copy to .env.production and set real URLs, image tags, and secret file paths.
# Secret files belong under ./secrets/ and are excluded from Git.
MYSQL_DATABASE=fixflow_ai
MYSQL_USER=fixflow
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
MYSQL_PASSWORD_FILE=./secrets/mysql_app_password
REDIS_PASSWORD_FILE=./secrets/redis_password
ACCESS_TOKEN_SECRET_FILE=./secrets/access_token_secret
METRICS_TOKEN_FILE=./secrets/metrics_token
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password
AI_SERVICE_TOKEN_FILE=./secrets/ai_service_token
WEB_ORIGIN=https://fixflow.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.fixflow.example.com/api/v1
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3001
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000
MYSQL_POOL_SIZE=10
AI_WORKER_CONCURRENCY=2
API_IMAGE=fixflow-ai-api:local
WEB_IMAGE=fixflow-ai-web:local
AI_IMAGE=fixflow-ai-service:local
