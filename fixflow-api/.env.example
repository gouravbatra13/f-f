PORT=3001
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33316
MYSQL_USER=fixflow
MYSQL_PASSWORD=replace-with-a-random-local-password
MYSQL_DATABASE=fixflow_ai
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
MYSQL_HOST_PORT=33316
MYSQL_POOL_SIZE=10
ACCESS_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Defaults to false locally and true in production.
COOKIE_SECURE=false
QUEUE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-random-local-redis-password
AI_WORKER_CONCURRENCY=2
METRICS_TOKEN=
# Optional Phase 9 local AI service. Configure the same random 32+ byte token
# in both processes to enable AI; leave both blank to keep AI disabled.
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_SERVICE_TOKEN=
# Defaults to the HuggingFace Sentence Transformers encoder. For a lower
# memory footprint, use the already-local Ollama embedding model instead.
# AI_EMBEDDING_PROVIDER=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text:latest
# AI_REQUEST_TIMEOUT_MS=120000
# AI_SIMILARITY_THRESHOLD=0.45
# AI_SIMILARITY_LIMIT=5
# OLLAMA_MODEL=deepseek-coder:latest
